# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

.env
.env.local
.env.*.local

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
worker/node_modules
worker/.wrangler
/platforms
/plugins
/www

# Generated by scripts/copy-tesseract-assets.js (postinstall) — vendored from node_modules
/public/tesseract

# Python bytecode cache (scripts/*.py)
__pycache__/
*.pyc
